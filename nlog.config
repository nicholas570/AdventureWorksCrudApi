<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <targets>
    <!-- SQL statements executed by EF Core -->
    <target xsi:type="File" name="sqlfile"
            fileName="${basedir}/logs/sql-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <!-- Everything else -->
    <target xsi:type="File" name="allfile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Route EF Core SQL commands to the SQL file only, then stop -->
    <logger name="Microsoft.EntityFrameworkCore.Database.Command" minlevel="Info" writeTo="sqlfile" final="true" />

    <!-- Drop the rest of the noisy framework logs -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Application logs -->
    <logger name="*" minlevel="Info" writeTo="allfile" />
  </rules>
</nlog>
